# Local journals and personal scratch work.
/v2/local/

# Reproducible sources, docs and inputs are versioned by default.
# Put generated captures, logs, profiles and scratch work in these folders.
# Research notes and diagnostic scripts are local; required inputs live
# under v2/benchmarks/inputs and the public plan is v2/ROADMAP.md.
/v2/audit/
/v2/benchmarks/results/
# Optional historical candidate and measured-source evidence stays local.
/v2/benchmarks/history/

# Historical raw evidence remains local and recoverable.
/.local-evidence/
