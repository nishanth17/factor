# Benchmarks: publish runners, documentation, corpora and frozen controls.
/v2/benchmarks/*
!/v2/benchmarks/*.py
!/v2/benchmarks/README.md
!/v2/benchmarks/phase_two_corpus.json
!/v2/benchmarks/phase_two_complete_corpus.json
!/v2/benchmarks/phase_two_m15_independent_corpus.json
!/v2/benchmarks/phase_two_competitors.json
!/v2/benchmarks/phase_three_p34_corpus.json
!/v2/benchmarks/phase_three_p34_large_v3_corpus.json
!/v2/benchmarks/phase_three_p36_corpus.json
!/v2/benchmarks/phase_three_m25_p33_refinement_pypy.frozen.json

# Run outputs (JSON/gzip captures, logs, profiles, verification dumps and
# scratch directories) stay local. Add a specific exception for a new input.

# Required immutable source input for matched QS correction benchmarks.
!/v2/benchmarks/qs_m26_baseline.json
!/v2/benchmarks/performance_audit_baseline.json
!/v2/benchmarks/performance_audit_corpus.json
